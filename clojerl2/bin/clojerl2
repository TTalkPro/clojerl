#!/bin/sh
# clojerl2 — REPL and script runner (clojerl2-023); see src/erl/clj2_cli.erl.
# Needs `make` first: ebin/ holds the compiler and a prebuilt clojure.core.
# CLJ2_ERL_FLAGS: extra VM flags (test/cts.sh caps the process heap with it).
here=$(cd "$(dirname "$0")/.." && pwd)
exec erl ${CLJ2_ERL_FLAGS:-} -noshell -pa "$here/ebin" \
     -kernel shell_history enabled \
     -run clj2_cli main -extra "$@"
