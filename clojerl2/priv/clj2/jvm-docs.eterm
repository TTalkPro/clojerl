{'clojure.core', <<"when"/utf8>>, <<"Evaluates test. If logical true, evaluates body in an implicit do."/utf8>>, <<"([test & body])"/utf8>>}.
{'clojure.core', <<"when-first"/utf8>>, <<"bindings => x xs\n\n  Roughly the same as (when (seq xs) (let [x (first xs)] body)) but xs is evaluated only once"/utf8>>, <<"([bindings & body])"/utf8>>}.
{'clojure.core', <<"when-let"/utf8>>, <<"bindings => binding-form test\n\n  When test is true, evaluates body with binding-form bound to the value of test"/utf8>>, <<"([bindings & body])"/utf8>>}.
{'clojure.core', <<"when-not"/utf8>>, <<"Evaluates test. If logical false, evaluates body in an implicit do."/utf8>>, <<"([test & body])"/utf8>>}.
{'clojure.core', <<"when-some"/utf8>>, <<"bindings => binding-form test\n\n   When test is not nil, evaluates body with binding-form bound to the\n   value of test"/utf8>>, <<"([bindings & body])"/utf8>>}.
{'clojure.core', <<"while"/utf8>>, <<"Repeatedly executes body while test expression is true. Presumes\n  some side-effect will cause test to become false/nil. Returns nil"/utf8>>, <<"([test & body])"/utf8>>}.
{'clojure.core', <<"with-bindings"/utf8>>, <<"Takes a map of Var/value pairs. Installs for the given Vars the associated\n  values as thread-local bindings. Then executes body. Pops the installed\n  bindings after body was evaluated. Returns the value of body."/utf8>>, <<"([binding-map & body])"/utf8>>}.
{'clojure.core', <<"with-bindings*"/utf8>>, <<"Takes a map of Var/value pairs. Installs for the given Vars the associated\n  values as thread-local bindings. Then calls f with the supplied arguments.\n  Pops the installed bindings after f returned. Returns whatever f returns."/utf8>>, <<"([binding-map f & args])"/utf8>>}.
{'clojure.core', <<"with-in-str"/utf8>>, <<"Evaluates body in a context in which *in* is bound to a fresh\n  StringReader initialized with the string s."/utf8>>, <<"([s & body])"/utf8>>}.
{'clojure.core', <<"with-loading-context"/utf8>>, nil, <<"([& body])"/utf8>>}.
{'clojure.core', <<"with-local-vars"/utf8>>, <<"varbinding=> symbol init-expr\n\n  Executes the exprs in a context in which the symbols are bound to\n  vars with per-thread bindings to the init-exprs.  The symbols refer\n  to the var objects themselves, and must be accessed with var-get and\n  var-set"/utf8>>, <<"([name-vals-vec & body])"/utf8>>}.
{'clojure.core', <<"with-meta"/utf8>>, <<"Returns an object of the same type and value as obj, with\n    map m as its metadata."/utf8>>, <<"([obj m])"/utf8>>}.
{'clojure.core', <<"with-open"/utf8>>, <<"bindings => [name init ...]\n\n  Evaluates body in a try expression with names bound to the values\n  of the inits, and a finally clause that calls (.close name) on each\n  name in reverse order."/utf8>>, <<"([bindings & body])"/utf8>>}.
{'clojure.core', <<"with-out-str"/utf8>>, <<"Evaluates exprs in a context in which *out* is bound to a fresh\n  StringWriter.  Returns the string created by any nested printing\n  calls."/utf8>>, <<"([& body])"/utf8>>}.
{'clojure.core', <<"with-precision"/utf8>>, <<"Sets the precision and rounding mode to be used for BigDecimal operations.\n\n  Usage: (with-precision 10 (/ 1M 3))\n  or:    (with-precision 10 :rounding HALF_DOWN (/ 1M 3))\n\n  The rounding mode is one of CEILING, FLOOR, HALF_UP, HALF_DOWN,\n  HALF_EVEN, UP, DOWN and UNNECESSARY; it defaults to HALF_UP."/utf8>>, <<"([precision & exprs])"/utf8>>}.
{'clojure.core', <<"with-redefs"/utf8>>, <<"binding => var-symbol temp-value-expr\n\n  Temporarily redefines Vars while executing the body.  The\n  temp-value-exprs will be evaluated and each resulting value will\n  replace in parallel the root value of its Var.  After the body is\n  executed, the root values of all the Vars will be set back to their\n  old values.  These temporary changes will be visible in all threads.\n  Useful for mocking out functions during testing."/utf8>>, <<"([bindings & body])"/utf8>>}.
{'clojure.core', <<"with-redefs-fn"/utf8>>, <<"Temporarily redefines Vars during a call to func.  Each val of\n  binding-map will replace the root value of its key which must be\n  a Var.  After func is called with no args, the root values of all\n  the Vars will be set back to their old values.  These temporary\n  changes will be visible in all threads.  Useful for mocking out\n  functions during testing."/utf8>>, <<"([binding-map func])"/utf8>>}.
{'clojure.core', <<"xml-seq"/utf8>>, <<"A tree seq on the xml elements as per xml/parse"/utf8>>, <<"([root])"/utf8>>}.
{'clojure.core', <<"zero?"/utf8>>, <<"Returns true if num is zero, else false"/utf8>>, <<"([num])"/utf8>>}.
{'clojure.core', <<"zipmap"/utf8>>, <<"Returns a map with the keys mapped to the corresponding vals."/utf8>>, <<"([keys vals])"/utf8>>}.
{'clojure.string', <<"blank?"/utf8>>, <<"True if s is nil, empty, or contains only whitespace."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"capitalize"/utf8>>, <<"Converts first character of the string to upper-case, all other\n  characters to lower-case."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"ends-with?"/utf8>>, <<"True if s ends with substr."/utf8>>, <<"([s substr])"/utf8>>}.
{'clojure.string', <<"escape"/utf8>>, <<"Return a new string, using cmap to escape each character ch\n   from s as follows:\n   \n   If (cmap ch) is nil, append ch to the new string.\n   If (cmap ch) is non-nil, append (str (cmap ch)) instead."/utf8>>, <<"([s cmap])"/utf8>>}.
{'clojure.string', <<"includes?"/utf8>>, <<"True if s includes substr."/utf8>>, <<"([s substr])"/utf8>>}.
{'clojure.string', <<"index-of"/utf8>>, <<"Return index of value (string or char) in s, optionally searching\n  forward from from-index. Return nil if value not found."/utf8>>, <<"([s value] [s value from-index])"/utf8>>}.
{'clojure.string', <<"join"/utf8>>, <<"Returns a string of all elements in coll, as returned by (seq coll),\n   separated by an optional separator."/utf8>>, <<"([coll] [separator coll])"/utf8>>}.
{'clojure.string', <<"last-index-of"/utf8>>, <<"Return last index of value (string or char) in s, optionally\n  searching backward from from-index. Return nil if value not found."/utf8>>, <<"([s value] [s value from-index])"/utf8>>}.
{'clojure.string', <<"lower-case"/utf8>>, <<"Converts string to all lower-case."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"re-quote-replacement"/utf8>>, <<"Given a replacement string that you wish to be a literal\n   replacement for a pattern match in replace or replace-first, do the\n   necessary escaping of special characters in the replacement."/utf8>>, <<"([replacement])"/utf8>>}.
{'clojure.string', <<"replace"/utf8>>, <<"Replaces all instance of match with replacement in s.\n\n   match/replacement can be:\n\n   string / string\n   char / char\n   pattern / (string or function of match).\n\n   See also replace-first.\n\n   The replacement is literal (i.e. none of its characters are treated\n   specially) for all cases above except pattern / string.\n\n   For pattern / string, $1, $2, etc. in the replacement string are\n   substituted with the string that matched the corresponding\n   parenthesized group in the pattern.  If you wish your replacement\n   string r to be used literally, use (re-quote-replacement r) as the\n   replacement argument.  See also documentation for\n   java.util.regex.Matcher's appendReplacement method.\n\n   Example:\n   (clojure.string/replace \"Almost Pig Latin\" #\"\\b(\\w)(\\w+)\\b\" \"$2$1ay\")\n   -> \"lmostAay igPay atinLay\""/utf8>>, <<"([s match replacement])"/utf8>>}.
{'clojure.string', <<"replace-first"/utf8>>, <<"Replaces the first instance of match with replacement in s.\n\n   match/replacement can be:\n\n   char / char\n   string / string\n   pattern / (string or function of match).\n\n   See also replace.\n\n   The replacement is literal (i.e. none of its characters are treated\n   specially) for all cases above except pattern / string.\n\n   For pattern / string, $1, $2, etc. in the replacement string are\n   substituted with the string that matched the corresponding\n   parenthesized group in the pattern.  If you wish your replacement\n   string r to be used literally, use (re-quote-replacement r) as the\n   replacement argument.  See also documentation for\n   java.util.regex.Matcher's appendReplacement method.\n\n   Example:\n   (clojure.string/replace-first \"swap first two words\"\n                                 #\"(\\w+)(\\s+)(\\w+)\" \"$3$2$1\")\n   -> \"first swap two words\""/utf8>>, <<"([s match replacement])"/utf8>>}.
{'clojure.string', <<"reverse"/utf8>>, <<"Returns s with its characters reversed."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"split"/utf8>>, <<"Splits string on a regular expression.  Optional argument limit is\n  the maximum number of parts. Not lazy. Returns vector of the parts.\n  Trailing empty strings are not returned - pass limit of -1 to return all."/utf8>>, <<"([s re] [s re limit])"/utf8>>}.
{'clojure.string', <<"split-lines"/utf8>>, <<"Splits s on \\n or \\r\\n. Trailing empty lines are not returned."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"starts-with?"/utf8>>, <<"True if s starts with substr."/utf8>>, <<"([s substr])"/utf8>>}.
{'clojure.string', <<"trim"/utf8>>, <<"Removes whitespace from both ends of string."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"trim-newline"/utf8>>, <<"Removes all trailing newline \\n or return \\r characters from\n  string.  Similar to Perl's chomp."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"triml"/utf8>>, <<"Removes whitespace from the left side of string."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"trimr"/utf8>>, <<"Removes whitespace from the right side of string."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.string', <<"upper-case"/utf8>>, <<"Converts string to all upper-case."/utf8>>, <<"([s])"/utf8>>}.
{'clojure.set', <<"difference"/utf8>>, <<"Return a set that is the first set without elements of the remaining sets"/utf8>>, <<"([s1] [s1 s2] [s1 s2 & sets])"/utf8>>}.
{'clojure.set', <<"index"/utf8>>, <<"Returns a map of the distinct values of ks in the xrel mapped to a\n  set of the maps in xrel with the corresponding values of ks."/utf8>>, <<"([xrel ks])"/utf8>>}.
{'clojure.set', <<"intersection"/utf8>>, <<"Return a set that is the intersection of the input sets"/utf8>>, <<"([s1] [s1 s2] [s1 s2 & sets])"/utf8>>}.
{'clojure.set', <<"join"/utf8>>, <<"When passed 2 rels, returns the rel corresponding to the natural\n  join. When passed an additional keymap, joins on the corresponding\n  keys."/utf8>>, <<"([xrel yrel] [xrel yrel km])"/utf8>>}.
{'clojure.set', <<"map-invert"/utf8>>, <<"Returns the map with the vals mapped to the keys."/utf8>>, <<"([m])"/utf8>>}.
{'clojure.set', <<"project"/utf8>>, <<"Returns a rel of the elements of xrel with only the keys in ks"/utf8>>, <<"([xrel ks])"/utf8>>}.
{'clojure.set', <<"rename"/utf8>>, <<"Returns a rel of the maps in xrel with the keys in kmap renamed to the vals in kmap"/utf8>>, <<"([xrel kmap])"/utf8>>}.
{'clojure.set', <<"rename-keys"/utf8>>, <<"Returns the map with the keys in kmap renamed to the vals in kmap"/utf8>>, <<"([map kmap])"/utf8>>}.
{'clojure.set', <<"select"/utf8>>, <<"Returns a set of the elements for which pred is true"/utf8>>, <<"([pred xset])"/utf8>>}.
{'clojure.set', <<"subset?"/utf8>>, <<"Is set1 a subset of set2?"/utf8>>, <<"([set1 set2])"/utf8>>}.
{'clojure.set', <<"superset?"/utf8>>, <<"Is set1 a superset of set2?"/utf8>>, <<"([set1 set2])"/utf8>>}.
{'clojure.set', <<"union"/utf8>>, <<"Return a set that is the union of the input sets"/utf8>>, <<"([] [s1] [s1 s2] [s1 s2 & sets])"/utf8>>}.
{'clojure.walk', <<"keywordize-keys"/utf8>>, <<"Recursively transforms all map keys from strings to keywords."/utf8>>, <<"([m])"/utf8>>}.
{'clojure.walk', <<"macroexpand-all"/utf8>>, <<"Recursively performs all possible macroexpansions in form."/utf8>>, <<"([form])"/utf8>>}.
{'clojure.walk', <<"postwalk"/utf8>>, <<"Performs a depth-first, post-order traversal of form.  Calls f on\n  each sub-form, uses f's return value in place of the original.\n  Recognizes all Clojure data structures. Consumes seqs as with doall."/utf8>>, <<"([f form])"/utf8>>}.
{'clojure.walk', <<"postwalk-demo"/utf8>>, <<"Demonstrates the behavior of postwalk by printing each form as it is\n  walked.  Returns form."/utf8>>, <<"([form])"/utf8>>}.
{'clojure.walk', <<"postwalk-replace"/utf8>>, <<"Recursively transforms form by replacing keys in smap with their\n  values.  Like clojure/replace but works on any data structure.  Does\n  replacement at the leaves of the tree first."/utf8>>, <<"([smap form])"/utf8>>}.
{'clojure.walk', <<"prewalk"/utf8>>, <<"Like postwalk, but does pre-order traversal."/utf8>>, <<"([f form])"/utf8>>}.
{'clojure.walk', <<"prewalk-demo"/utf8>>, <<"Demonstrates the behavior of prewalk by printing each form as it is\n  walked.  Returns form."/utf8>>, <<"([form])"/utf8>>}.
{'clojure.walk', <<"prewalk-replace"/utf8>>, <<"Recursively transforms form by replacing keys in smap with their\n  values.  Like clojure/replace but works on any data structure.  Does\n  replacement at the root of the tree first."/utf8>>, <<"([smap form])"/utf8>>}.
{'clojure.walk', <<"stringify-keys"/utf8>>, <<"Recursively transforms all map keys from keywords to strings."/utf8>>, <<"([m])"/utf8>>}.
{'clojure.walk', <<"walk"/utf8>>, <<"Traverses form, an arbitrary data structure.  inner and outer are\n  functions.  Applies inner to each element of form, building up a\n  data structure of the same type, then applies outer to the result.\n  Recognizes all Clojure data structures. Consumes seqs as with doall."/utf8>>, <<"([inner outer form])"/utf8>>}.
{'clojure.edn', <<"read"/utf8>>, <<"Reads the next object from stream, which must be an instance of\n  java.io.PushbackReader or some derivee.  stream defaults to the\n  current value of *in*.\n\n  Reads data in the edn format (subset of Clojure data):\n  http://edn-format.org\n\n  opts is a map that can include the following keys:\n  :eof - value to return on end-of-file. When not supplied, eof throws an exception.\n  :readers  - a map of tag symbols to data-reader functions to be considered before default-data-readers.\n              When not supplied, only the default-data-readers will be used.\n  :default - A function of two args, that will, if present and no reader is found for a tag,\n             be called with the tag and the value."/utf8>>, <<"([] [stream] [opts stream])"/utf8>>}.
{'clojure.edn', <<"read-string"/utf8>>, <<"Reads one object from the string s. Returns nil when s is nil or empty.\n\n  Reads data in the edn format (subset of Clojure data):\n  http://edn-format.org\n\n  opts is a map as per clojure.edn/read"/utf8>>, <<"([s] [opts s])"/utf8>>}.
{'clojure.math', <<"E"/utf8>>, <<"Constant for e, the base for natural logarithms.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#E"/utf8>>, nil}.
{'clojure.math', <<"IEEE-remainder"/utf8>>, <<"Returns the remainder per IEEE 754 such that\n    remainder = dividend - divisor * n\n  where n is the integer closest to the exact value of dividend / divisor.\n  If two integers are equally close, then n is the even one.\n  If the remainder is zero, sign will match dividend.\n  If dividend or divisor is ##NaN, or dividend is ##Inf or ##-Inf, or divisor is zero => ##NaN\n  If dividend is finite and divisor is infinite => dividend\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#IEEEremainder-double-double-"/utf8>>, <<"([dividend divisor])"/utf8>>}.
{'clojure.math', <<"PI"/utf8>>, <<"Constant for pi, the ratio of the circumference of a circle to its diameter.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#PI"/utf8>>, nil}.
{'clojure.math', <<"acos"/utf8>>, <<"Returns the arc cosine of a, in the range 0.0 to pi.\n  If a is ##NaN or |a|>1 => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#acos-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"add-exact"/utf8>>, <<"Returns the sum of x and y, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#addExact-long-long-"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.math', <<"asin"/utf8>>, <<"Returns the arc sine of an angle, in the range -pi/2 to pi/2.\n  If a is ##NaN or |a|>1 => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#asin-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"atan"/utf8>>, <<"Returns the arc tangent of a, in the range of -pi/2 to pi/2.\n  If a is ##NaN => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#atan-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"atan2"/utf8>>, <<"Returns the angle theta from the conversion of rectangular coordinates (x, y) to polar coordinates (r, theta).\n  Computes the phase theta by computing an arc tangent of y/x in the range of -pi to pi.\n  For more details on special cases, see:\n  https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#atan2-double-double-"/utf8>>, <<"([y x])"/utf8>>}.
{'clojure.math', <<"cbrt"/utf8>>, <<"Returns the cube root of a.\n  If a is ##NaN => ##NaN\n  If a is ##Inf or ##-Inf => a\n  If a is zero => zero with sign matching a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#cbrt-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"ceil"/utf8>>, <<"Returns the smallest double greater than or equal to a, and equal to a\n  mathematical integer.\n  If a is ##NaN or ##Inf or ##-Inf or already equal to an integer => a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#ceil-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"copy-sign"/utf8>>, <<"Returns a double with the magnitude of the first argument and the sign of\n  the second.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#copySign-double-double-"/utf8>>, <<"([magnitude sign])"/utf8>>}.
{'clojure.math', <<"cos"/utf8>>, <<"Returns the cosine of an angle.\n  If a is ##NaN, ##-Inf, ##Inf => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#cos-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"cosh"/utf8>>, <<"Returns the hyperbolic cosine of x, (e^x + e^-x)/2.\n  If x is ##NaN => ##NaN\n  If x is ##Inf or ##-Inf => ##Inf\n  If x is zero => 1.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#cosh-double-"/utf8>>, <<"([x])"/utf8>>}.
{'clojure.math', <<"decrement-exact"/utf8>>, <<"Returns a decremented by 1, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#decrementExact-long-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"exp"/utf8>>, <<"Returns Euler's number e raised to the power of a.\n  If a is ##NaN => ##NaN\n  If a is ##Inf => ##Inf\n  If a is ##-Inf => +0.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#exp-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"expm1"/utf8>>, <<"Returns e^x - 1. Near 0, expm1(x)+1 is more accurate to e^x than exp(x).\n  If x is ##NaN => ##NaN\n  If x is ##Inf => #Inf\n  If x is ##-Inf => -1.0\n  If x is zero => x\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#expm1-double-"/utf8>>, <<"([x])"/utf8>>}.
{'clojure.math', <<"floor"/utf8>>, <<"Returns the largest double less than or equal to a, and equal to a\n  mathematical integer.\n  If a is ##NaN or ##Inf or ##-Inf or already equal to an integer => a\n  If a is less than zero but greater than -1.0 => -0.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#floor-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"floor-div"/utf8>>, <<"Integer division that rounds to negative infinity (as opposed to zero).\n  The special case (floorDiv Long/MIN_VALUE -1) overflows and returns Long/MIN_VALUE.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#floorDiv-long-long-"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.math', <<"floor-mod"/utf8>>, <<"Integer modulus x - (floorDiv(x, y) * y). Sign matches y and is in the\n  range -|y| < r < |y|.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#floorMod-long-long-"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.math', <<"get-exponent"/utf8>>, <<"Returns the exponent of d.\n  If d is ##NaN, ##Inf, ##-Inf => Double/MAX_EXPONENT + 1\n  If d is zero or subnormal => Double/MIN_EXPONENT - 1\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#getExponent-double-"/utf8>>, <<"([d])"/utf8>>}.
{'clojure.math', <<"hypot"/utf8>>, <<"Returns sqrt(x^2 + y^2) without intermediate underflow or overflow.\n  If x or y is ##Inf or ##-Inf => ##Inf\n  If x or y is ##NaN and neither is ##Inf or ##-Inf => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#hypot-double-double-"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.math', <<"increment-exact"/utf8>>, <<"Returns a incremented by 1, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#incrementExact-long-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"log"/utf8>>, <<"Returns the natural logarithm (base e) of a.\n  If a is ##NaN or negative => ##NaN\n  If a is ##Inf => ##Inf\n  If a is zero => ##-Inf\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#log-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"log10"/utf8>>, <<"Returns the logarithm (base 10) of a.\n  If a is ##NaN or negative => ##NaN\n  If a is ##Inf => ##Inf\n  If a is zero => ##-Inf\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#log10-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"log1p"/utf8>>, <<"Returns ln(1+x). For small values of x, log1p(x) is more accurate than\n  log(1.0+x).\n  If x is ##NaN or < -1 => ##NaN\n  If x is ##Inf => ##Inf\n  If x is -1 => ##-Inf\n  If x is 0 => 0 with sign matching x\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#log1p-double-"/utf8>>, <<"([x])"/utf8>>}.
{'clojure.math', <<"multiply-exact"/utf8>>, <<"Returns the product of x and y, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#multiplyExact-long-long-"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.math', <<"negate-exact"/utf8>>, <<"Returns the negation of a, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#negateExact-long-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"next-after"/utf8>>, <<"Returns the adjacent floating point number to start in the direction of\n  the second argument. If the arguments are equal, the second is returned.\n  If either arg is #NaN => #NaN\n  If both arguments are signed zeros => direction\n  If start is +-Double/MIN_VALUE and direction would cause a smaller magnitude\n    => zero with sign matching start\n  If start is ##Inf or ##-Inf and direction would cause a smaller magnitude\n    => Double/MAX_VALUE with same sign as start\n  If start is equal to +=Double/MAX_VALUE and direction would cause a larger magnitude\n    => ##Inf or ##-Inf with sign matching start\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextAfter-double-double-"/utf8>>, <<"([start direction])"/utf8>>}.
{'clojure.math', <<"next-down"/utf8>>, <<"Returns the adjacent double of d in the direction of ##-Inf.\n  If d is ##NaN => ##NaN\n  If d is ##-Inf => ##-Inf\n  If d is zero => -Double/MIN_VALUE\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextDown-double-"/utf8>>, <<"([d])"/utf8>>}.
{'clojure.math', <<"next-up"/utf8>>, <<"Returns the adjacent double of d in the direction of ##Inf.\n  If d is ##NaN => ##NaN\n  If d is ##Inf => ##Inf\n  If d is zero => Double/MIN_VALUE\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextUp-double-"/utf8>>, <<"([d])"/utf8>>}.
{'clojure.math', <<"pow"/utf8>>, <<"Returns the value of a raised to the power of b.\n  For more details on special cases, see:\n  https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#pow-double-double-"/utf8>>, <<"([a b])"/utf8>>}.
{'clojure.math', <<"random"/utf8>>, <<"Returns a positive double between 0.0 and 1.0, chosen pseudorandomly with\n  approximately random distribution.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#random--"/utf8>>, <<"([])"/utf8>>}.
{'clojure.math', <<"rint"/utf8>>, <<"Returns the double closest to a and equal to a mathematical integer.\n  If two values are equally close, return the even one.\n  If a is ##NaN or ##Inf or ##-Inf or zero => a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#rint-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"round"/utf8>>, <<"Returns the closest long to a. If equally close to two values, return the one\n  closer to ##Inf.\n  If a is ##NaN => 0\n  If a is ##-Inf or < Long/MIN_VALUE => Long/MIN_VALUE\n  If a is ##Inf or > Long/MAX_VALUE => Long/MAX_VALUE\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#round-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"scalb"/utf8>>, <<"Returns d * 2^scaleFactor, scaling by a factor of 2. If the exponent\n  is between Double/MIN_EXPONENT and Double/MAX_EXPONENT, the answer is exact.\n  If d is ##NaN => ##NaN\n  If d is ##Inf or ##-Inf => ##Inf or ##-Inf respectively\n  If d is zero => zero of same sign as d\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextDown-double-"/utf8>>, <<"([d scaleFactor])"/utf8>>}.
{'clojure.math', <<"signum"/utf8>>, <<"Returns the signum function of d - zero for zero, 1.0 if >0, -1.0 if <0.\n  If d is ##NaN => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#signum-double-"/utf8>>, <<"([d])"/utf8>>}.
{'clojure.math', <<"sin"/utf8>>, <<"Returns the sine of an angle.\n  If a is ##NaN, ##-Inf, ##Inf => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#sin-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"sinh"/utf8>>, <<"Returns the hyperbolic sine of x, (e^x - e^-x)/2.\n  If x is ##NaN => ##NaN\n  If x is ##Inf or ##-Inf or zero => x\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#sinh-double-"/utf8>>, <<"([x])"/utf8>>}.
{'clojure.math', <<"sqrt"/utf8>>, <<"Returns the positive square root of a.\n  If a is ##NaN or negative => ##NaN\n  If a is ##Inf => ##Inf\n  If a is zero => a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#sqrt-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"subtract-exact"/utf8>>, <<"Returns the difference of x and y, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#subtractExact-long-long-"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.math', <<"tan"/utf8>>, <<"Returns the tangent of an angle.\n  If a is ##NaN, ##-Inf, ##Inf => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#tan-double-"/utf8>>, <<"([a])"/utf8>>}.
{'clojure.math', <<"tanh"/utf8>>, <<"Returns the hyperbolic tangent of x, sinh(x)/cosh(x).\n  If x is ##NaN => ##NaN\n  If x is zero => zero, with same sign\n  If x is ##Inf => +1.0\n  If x is ##-Inf => -1.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#tanh-double-"/utf8>>, <<"([x])"/utf8>>}.
{'clojure.math', <<"to-degrees"/utf8>>, <<"Converts an angle in radians to an approximate equivalent angle in degrees.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#toDegrees-double-"/utf8>>, <<"([r])"/utf8>>}.
{'clojure.math', <<"to-radians"/utf8>>, <<"Converts an angle in degrees to an approximate equivalent angle in radians.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#toRadians-double-"/utf8>>, <<"([deg])"/utf8>>}.
{'clojure.math', <<"ulp"/utf8>>, <<"Returns the size of an ulp (unit in last place) for d.\n  If d is ##NaN => ##NaN\n  If d is ##Inf or ##-Inf => ##Inf\n  If d is zero => Double/MIN_VALUE\n  If d is +/- Double/MAX_VALUE => 2^971\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#ulp-double-"/utf8>>, <<"([d])"/utf8>>}.
{'clojure.template', <<"apply-template"/utf8>>, <<"For use in macros.  argv is an argument list, as in defn.  expr is\n  a quoted expression using the symbols in argv.  values is a sequence\n  of values to be used for the arguments.\n\n  apply-template will recursively replace argument symbols in expr\n  with their corresponding values, returning a modified expr.\n\n  Example: (apply-template '[x] '(+ x x) '[2])\n           ;=> (+ 2 2)"/utf8>>, <<"([argv expr values])"/utf8>>}.
{'clojure.template', <<"do-template"/utf8>>, <<"Repeatedly copies expr (in a do block) for each group of arguments\n  in values.  values are automatically partitioned by the number of\n  arguments in argv, an argument vector as in defn.\n\n  Example: (macroexpand '(do-template [x y] (+ y x) 2 4 3 5))\n           ;=> (do (+ 4 2) (+ 5 3))"/utf8>>, <<"([argv expr & values])"/utf8>>}.
{'clojure.test', <<"*load-tests*"/utf8>>, <<"True by default.  If set to false, no test functions will\n   be created by deftest, set-test, or with-test.  Use this to omit\n   tests when compiling or loading production code."/utf8>>, nil}.
{'clojure.test', <<"*stack-trace-depth*"/utf8>>, <<"The maximum depth of stack traces to print when an Exception\n  is thrown during a test.  Defaults to nil, which means print the \n  complete stack trace."/utf8>>, nil}.
{'clojure.test', <<"are"/utf8>>, <<"Checks multiple assertions with a template expression.\n  See clojure.template/do-template for an explanation of\n  templates.\n\n  Example: (are [x y] (= x y)  \n                2 (+ 1 1)\n                4 (* 2 2))\n  Expands to: \n           (do (is (= 2 (+ 1 1)))\n               (is (= 4 (* 2 2))))\n\n  Note: This breaks some reporting features, such as line numbers."/utf8>>, <<"([argv expr & args])"/utf8>>}.
{'clojure.test', <<"assert-any"/utf8>>, <<"Returns generic assertion code for any test, including macros, Java\n  method calls, or isolated symbols."/utf8>>, <<"([msg form])"/utf8>>}.
{'clojure.test', <<"assert-predicate"/utf8>>, <<"Returns generic assertion code for any functional predicate.  The\n  'expected' argument to 'report' will contains the original form, the\n  'actual' argument will contain the form with all its sub-forms\n  evaluated.  If the predicate returns false, the 'actual' form will\n  be wrapped in (not...)."/utf8>>, <<"([msg form])"/utf8>>}.
{'clojure.test', <<"compose-fixtures"/utf8>>, <<"Composes two fixture functions, creating a new fixture function\n  that combines their behavior."/utf8>>, <<"([f1 f2])"/utf8>>}.
{'clojure.test', <<"deftest"/utf8>>, <<"Defines a test function with no arguments.  Test functions may call\n  other tests, so tests may be composed.  If you compose tests, you\n  should also define a function named test-ns-hook; run-tests will\n  call test-ns-hook instead of testing all vars.\n\n  Note: Actually, the test body goes in the :test metadata on the var,\n  and the real function (the value of the var) calls test-var on\n  itself.\n\n  When *load-tests* is false, deftest is ignored."/utf8>>, <<"([name & body])"/utf8>>}.
{'clojure.test', <<"deftest-"/utf8>>, <<"Like deftest but creates a private var."/utf8>>, <<"([name & body])"/utf8>>}.
{'clojure.test', <<"do-report"/utf8>>, <<"Add file and line information to a test result and call report.\n   If you are writing a custom assert-expr method, call this function\n   to pass test results to report."/utf8>>, <<"([m])"/utf8>>}.
{'clojure.test', <<"file-position"/utf8>>, <<"Returns a vector [filename line-number] for the nth call up the\n  stack.\n\n  Deprecated in 1.2: The information needed for test reporting is\n  now on :file and :line keys in the result map."/utf8>>, <<"([n])"/utf8>>}.
{'clojure.test', <<"function?"/utf8>>, <<"Returns true if argument is a function or a symbol that resolves to\n  a function (not a macro)."/utf8>>, <<"([x])"/utf8>>}.
{'clojure.test', <<"get-possibly-unbound-var"/utf8>>, <<"Like var-get but returns nil if the var is unbound."/utf8>>, <<"([v])"/utf8>>}.
{'clojure.test', <<"inc-report-counter"/utf8>>, <<"Increments the named counter in *report-counters*, a ref to a map.\n  Does nothing if *report-counters* is nil."/utf8>>, <<"([name])"/utf8>>}.
{'clojure.test', <<"is"/utf8>>, <<"Generic assertion macro.  'form' is any predicate test.\n  'msg' is an optional message to attach to the assertion.\n  \n  Example: (is (= 4 (+ 2 2)) \"Two plus two should be 4\")\n\n  Special forms:\n\n  (is (thrown? c body)) checks that an instance of c is thrown from\n  body, fails if not; then returns the thing thrown.\n\n  (is (thrown-with-msg? c re body)) checks that an instance of c is\n  thrown AND that the message on the exception matches (with\n  re-find) the regular expression re."/utf8>>, <<"([form] [form msg])"/utf8>>}.
{'clojure.test', <<"join-fixtures"/utf8>>, <<"Composes a collection of fixtures, in order.  Always returns a valid\n  fixture function, even if the collection is empty."/utf8>>, <<"([fixtures])"/utf8>>}.
{'clojure.test', <<"report"/utf8>>, <<"Generic reporting function, may be overridden to plug in\n   different report formats (e.g., TAP, JUnit).  Assertions such as\n   'is' call 'report' to indicate results.  The argument given to\n   'report' will be a map with a :type key.  See the documentation at\n   the top of test_is.clj for more information on the types of\n   arguments for 'report'."/utf8>>, nil}.
{'clojure.test', <<"run-all-tests"/utf8>>, <<"Runs all tests in all namespaces; prints results.\n  Optional argument is a regular expression; only namespaces with\n  names matching the regular expression (with re-matches) will be\n  tested."/utf8>>, <<"([] [re])"/utf8>>}.
{'clojure.test', <<"run-test"/utf8>>, <<"Runs a single test.\n\n  Because the intent is to run a single test, there is no check for the namespace test-ns-hook."/utf8>>, <<"([test-symbol])"/utf8>>}.
{'clojure.test', <<"run-test-var"/utf8>>, <<"Runs the tests for a single Var, with fixtures executed around the test, and summary output after."/utf8>>, <<"([v])"/utf8>>}.
{'clojure.test', <<"run-tests"/utf8>>, <<"Runs all tests in the given namespaces; prints results.\n  Defaults to current namespace if none given.  Returns a map\n  summarizing test results."/utf8>>, <<"([] [& namespaces])"/utf8>>}.
{'clojure.test', <<"set-test"/utf8>>, <<"Experimental.\n  Sets :test metadata of the named var to a fn with the given body.\n  The var must already exist.  Does not modify the value of the var.\n\n  When *load-tests* is false, set-test is ignored."/utf8>>, <<"([name & body])"/utf8>>}.
{'clojure.test', <<"successful?"/utf8>>, <<"Returns true if the given test summary indicates all tests\n  were successful, false otherwise."/utf8>>, <<"([summary])"/utf8>>}.
{'clojure.test', <<"test-all-vars"/utf8>>, <<"Calls test-vars on every var interned in the namespace, with fixtures."/utf8>>, <<"([ns])"/utf8>>}.
{'clojure.test', <<"test-ns"/utf8>>, <<"If the namespace defines a function named test-ns-hook, calls that.\n  Otherwise, calls test-all-vars on the namespace.  'ns' is a\n  namespace object or a symbol.\n\n  Internally binds *report-counters* to a ref initialized to\n  *initial-report-counters*.  Returns the final, dereferenced state of\n  *report-counters*."/utf8>>, <<"([ns])"/utf8>>}.
{'clojure.test', <<"test-var"/utf8>>, <<"If v has a function in its :test metadata, calls that function,\n  with *testing-vars* bound to (conj *testing-vars* v)."/utf8>>, <<"([v])"/utf8>>}.
{'clojure.test', <<"test-vars"/utf8>>, <<"Groups vars by their namespace and runs test-var on them with\n  appropriate fixtures applied."/utf8>>, <<"([vars])"/utf8>>}.
{'clojure.test', <<"testing"/utf8>>, <<"Adds a new string to the list of testing contexts.  May be nested,\n  but must occur inside a test function (deftest)."/utf8>>, <<"([string & body])"/utf8>>}.
{'clojure.test', <<"testing-contexts-str"/utf8>>, <<"Returns a string representation of the current test context. Joins\n  strings in *testing-contexts* with spaces."/utf8>>, <<"([])"/utf8>>}.
{'clojure.test', <<"testing-vars-str"/utf8>>, <<"Returns a string representation of the current test.  Renders names\n  in *testing-vars* as a list, then the source file and line of\n  current assertion."/utf8>>, <<"([m])"/utf8>>}.
{'clojure.test', <<"try-expr"/utf8>>, <<"Used by the 'is' macro to catch unexpected exceptions.\n  You don't call this."/utf8>>, <<"([msg form])"/utf8>>}.
{'clojure.test', <<"use-fixtures"/utf8>>, <<"Wrap test runs in a fixture function to perform setup and\n  teardown. Using a fixture-type of :each wraps every test\n  individually, while :once wraps the whole run in a single function."/utf8>>, nil}.
{'clojure.test', <<"with-test"/utf8>>, <<"Takes any definition form (that returns a Var) as the first argument.\n  Remaining body goes in the :test metadata function for that Var.\n\n  When *load-tests* is false, only evaluates the definition, ignoring\n  the tests."/utf8>>, <<"([definition & body])"/utf8>>}.
{'clojure.test', <<"with-test-out"/utf8>>, <<"Runs body with *out* bound to the value of *test-out*."/utf8>>, <<"([& body])"/utf8>>}.
{'clojure.repl', <<"apropos"/utf8>>, <<"Given a regular expression or stringable thing, return a seq of all\npublic definitions in all currently-loaded namespaces that match the\nstr-or-pattern."/utf8>>, <<"([str-or-pattern])"/utf8>>}.
{'clojure.repl', <<"demunge"/utf8>>, <<"Given a string representation of a fn class,\n  as in a stack trace element, returns a readable version."/utf8>>, <<"([fn-name])"/utf8>>}.
{'clojure.repl', <<"dir"/utf8>>, <<"Prints a sorted directory of public vars in a namespace"/utf8>>, <<"([nsname])"/utf8>>}.
{'clojure.repl', <<"dir-fn"/utf8>>, <<"Returns a sorted seq of symbols naming public vars in\n  a namespace or namespace alias. Looks for aliases in *ns*"/utf8>>, <<"([ns])"/utf8>>}.
{'clojure.repl', <<"doc"/utf8>>, <<"Prints documentation for a var or special form given its name,\n   or for a spec if given a keyword"/utf8>>, <<"([name])"/utf8>>}.
{'clojure.repl', <<"find-doc"/utf8>>, <<"Prints documentation for any var whose documentation or name\n contains a match for re-string-or-pattern"/utf8>>, <<"([re-string-or-pattern])"/utf8>>}.
{'clojure.repl', <<"pst"/utf8>>, <<"Prints a stack trace of the exception, to the depth requested. If none supplied, uses the root cause of the\n  most recent repl exception (*e), and a depth of 12."/utf8>>, <<"([] [e-or-depth] [e depth])"/utf8>>}.
{'clojure.repl', <<"root-cause"/utf8>>, <<"Returns the initial cause of an exception or error by peeling off all of\n  its wrappers"/utf8>>, <<"([t])"/utf8>>}.
{'clojure.repl', <<"set-break-handler!"/utf8>>, <<"Register INT signal handler.  After calling this, Ctrl-C will cause\n  the given function f to be called with a single argument, the signal.\n  Uses thread-stopper if no function given."/utf8>>, <<"([] [f])"/utf8>>}.
{'clojure.repl', <<"source"/utf8>>, <<"Prints the source code for the given symbol, if it can find it.\n  This requires that the symbol resolve to a Var defined in a\n  namespace for which the .clj is in the classpath.\n\n  Example: (source filter)"/utf8>>, <<"([n])"/utf8>>}.
{'clojure.repl', <<"source-fn"/utf8>>, <<"Returns a string of the source code for the given symbol, if it can\n  find it.  This requires that the symbol resolve to a Var defined in\n  a namespace for which the .clj is in the classpath.  Returns nil if\n  it can't find the source.  For most REPL usage, 'source' is more\n  convenient.\n\n  Example: (source-fn 'filter)"/utf8>>, <<"([x])"/utf8>>}.
{'clojure.repl', <<"stack-element-str"/utf8>>, <<"Returns a (possibly unmunged) string representation of a StackTraceElement"/utf8>>, <<"([el])"/utf8>>}.
{'clojure.repl', <<"thread-stopper"/utf8>>, <<"Returns a function that takes one arg and uses that as an exception message\n  to stop the given thread.  Defaults to the current thread"/utf8>>, <<"([] [thread])"/utf8>>}.
{'clojure.pprint', <<"*print-base*"/utf8>>, <<"The base to use for printing integers and rationals."/utf8>>, nil}.
{'clojure.pprint', <<"*print-miser-width*"/utf8>>, <<"The column at which to enter miser style. Depending on the dispatch table, \nmiser style add newlines in more places to try to keep lines short allowing for further \nlevels of nesting."/utf8>>, nil}.
{'clojure.pprint', <<"*print-pprint-dispatch*"/utf8>>, <<"The pretty print dispatch function. Use with-pprint-dispatch or set-pprint-dispatch\nto modify."/utf8>>, nil}.
{'clojure.pprint', <<"*print-pretty*"/utf8>>, <<"Bind to true if you want write to use pretty printing"/utf8>>, nil}.
{'clojure.pprint', <<"*print-radix*"/utf8>>, <<"Print a radix specifier in front of integers and rationals. If *print-base* is 2, 8, \nor 16, then the radix specifier used is #b, #o, or #x, respectively. Otherwise the \nradix specifier is in the form #XXr where XX is the decimal value of *print-base* "/utf8>>, nil}.
{'clojure.pprint', <<"*print-right-margin*"/utf8>>, <<"Pretty printing will try to avoid anything going beyond this column.\nSet it to nil to have pprint let the line be arbitrarily long. This will ignore all \nnon-mandatory newlines."/utf8>>, nil}.
{'clojure.pprint', <<"*print-suppress-namespaces*"/utf8>>, <<"Don't print namespaces with symbols. This is particularly useful when \npretty printing the results of macro expansions"/utf8>>, nil}.
{'clojure.pprint', <<"cl-format"/utf8>>, <<"An implementation of a Common Lisp compatible format function. cl-format formats its\narguments to an output stream or string based on the format control string given. It \nsupports sophisticated formatting of structured data.\n\nWriter is an instance of java.io.Writer, true to output to *out* or nil to output \nto a string, format-in is the format control string and the remaining arguments \nare the data to be formatted.\n\nThe format control string is a string to be output with embedded 'format directives' \ndescribing how to format the various arguments passed in.\n\nIf writer is nil, cl-format returns the formatted result string. Otherwise, cl-format \nreturns nil.\n\nFor example:\n (let [results [46 38 22]]\n        (cl-format true \"There ~[are~;is~:;are~]~:* ~d result~:p: ~{~d~^, ~}~%\" \n                   (count results) results))\n\nPrints to *out*:\n There are 3 results: 46, 38, 22\n\nDetailed documentation on format control strings is available in the \"Common Lisp the \nLanguage, 2nd edition\", Chapter 22 (available online at:\nhttp://www.cs.cmu.edu/afs/cs.cmu.edu/project/ai-repository/ai/html/cltl/clm/node200.html#SECTION002633000000000000000) \nand in the Common Lisp HyperSpec at \nhttp://www.lispworks.com/documentation/HyperSpec/Body/22_c.htm\n"/utf8>>, <<"([writer format-in & args])"/utf8>>}.
{'clojure.pprint', <<"code-dispatch"/utf8>>, <<"The pretty print dispatch function for pretty printing Clojure code."/utf8>>, <<"[[object]]"/utf8>>}.
{'clojure.pprint', <<"formatter"/utf8>>, <<"Makes a function which can directly run format-in. The function is\nfn [stream & args] ... and returns nil unless the stream is nil (meaning \noutput to a string) in which case it returns the resulting string.\n\nformat-in can be either a control string or a previously compiled format."/utf8>>, <<"([format-in])"/utf8>>}.
{'clojure.pprint', <<"formatter-out"/utf8>>, <<"Makes a function which can directly run format-in. The function is\nfn [& args] ... and returns nil. This version of the formatter macro is\ndesigned to be used with *out* set to an appropriate Writer. In particular,\nthis is meant to be used as part of a pretty printer dispatch method.\n\nformat-in can be either a control string or a previously compiled format."/utf8>>, <<"([format-in])"/utf8>>}.
{'clojure.pprint', <<"fresh-line"/utf8>>, <<"Make a newline if *out* is not already at the beginning of the line. If *out* is\nnot a pretty writer (which keeps track of columns), this function always outputs a newline."/utf8>>, <<"([])"/utf8>>}.
{'clojure.pprint', <<"get-pretty-writer"/utf8>>, <<"Returns the java.io.Writer passed in wrapped in a pretty writer proxy, unless it's \nalready a pretty writer. Generally, it is unnecessary to call this function, since pprint,\nwrite, and cl-format all call it if they need to. However if you want the state to be \npreserved across calls, you will want to wrap them with this. \n\nFor example, when you want to generate column-aware output with multiple calls to cl-format, \ndo it like in this example:\n\n    (defn print-table [aseq column-width]\n      (binding [*out* (get-pretty-writer *out*)]\n        (doseq [row aseq]\n          (doseq [col row]\n            (cl-format true \"~4D~7,vT\" col column-width))\n          (prn))))\n\nNow when you run:\n\n    user> (print-table (map #(vector % (* % %) (* % % %)) (range 1 11)) 8)\n\nIt prints a table of squares and cubes for the numbers from 1 to 10:\n\n       1      1       1    \n       2      4       8    \n       3      9      27    \n       4     16      64    \n       5     25     125    \n       6     36     216    \n       7     49     343    \n       8     64     512    \n       9     81     729    \n      10    100    1000"/utf8>>, <<"([writer])"/utf8>>}.
{'clojure.pprint', <<"pp"/utf8>>, <<"A convenience macro that pretty prints the last thing output. This is\nexactly equivalent to (pprint *1)."/utf8>>, <<"([])"/utf8>>}.
{'clojure.pprint', <<"pprint"/utf8>>, <<"Pretty print object to the optional output writer. If the writer is not provided, \nprint the object to the currently bound value of *out*."/utf8>>, <<"([object] [object writer])"/utf8>>}.
{'clojure.pprint', <<"pprint-indent"/utf8>>, <<"Create an indent at this point in the pretty printing stream. This defines how \nfollowing lines are indented. relative-to can be either :block or :current depending \nwhether the indent should be computed relative to the start of the logical block or\nthe current column position. n is an offset. \n\nThis function is intended for use when writing custom dispatch functions.\n\nOutput is sent to *out* which must be a pretty printing writer."/utf8>>, <<"([relative-to n])"/utf8>>}.
{'clojure.pprint', <<"pprint-logical-block"/utf8>>, <<"Execute the body as a pretty printing logical block with output to *out* which \nmust be a pretty printing writer. When used from pprint or cl-format, this can be \nassumed. \n\nThis function is intended for use when writing custom dispatch functions.\n\nBefore the body, the caller can optionally specify options: :prefix, :per-line-prefix, \nand :suffix."/utf8>>, <<"[[options* body]]"/utf8>>}.
{'clojure.pprint', <<"pprint-newline"/utf8>>, <<"Print a conditional newline to a pretty printing stream. kind specifies if the \nnewline is :linear, :miser, :fill, or :mandatory. \n\nThis function is intended for use when writing custom dispatch functions.\n\nOutput is sent to *out* which must be a pretty printing writer."/utf8>>, <<"([kind])"/utf8>>}.
{'clojure.pprint', <<"pprint-tab"/utf8>>, <<"Tab at this point in the pretty printing stream. kind specifies whether the tab\nis :line, :section, :line-relative, or :section-relative. \n\nColnum and colinc specify the target column and the increment to move the target\nforward if the output is already past the original target.\n\nThis function is intended for use when writing custom dispatch functions.\n\nOutput is sent to *out* which must be a pretty printing writer.\n\nTHIS FUNCTION IS NOT YET IMPLEMENTED."/utf8>>, <<"([kind colnum colinc])"/utf8>>}.
{'clojure.pprint', <<"print-length-loop"/utf8>>, <<"A version of loop that iterates at most *print-length* times. This is designed \nfor use in pretty-printer dispatch functions."/utf8>>, <<"([bindings & body])"/utf8>>}.
{'clojure.pprint', <<"print-table"/utf8>>, <<"Prints a collection of maps in a textual table. Prints table headings\n   ks, and then a line of output for each row, corresponding to the keys\n   in ks. If ks are not specified, use the keys of the first item in rows."/utf8>>, <<"([ks rows] [rows])"/utf8>>}.
{'clojure.pprint', <<"set-pprint-dispatch"/utf8>>, <<"Set the pretty print dispatch function to a function matching (fn [obj] ...)\nwhere obj is the object to pretty print. That function will be called with *out* set\nto a pretty printing writer to which it should do its printing.\n\nFor example functions, see simple-dispatch and code-dispatch in \nclojure.pprint.dispatch.clj."/utf8>>, <<"([function])"/utf8>>}.
{'clojure.pprint', <<"simple-dispatch"/utf8>>, <<"The pretty print dispatch function for simple data structure format."/utf8>>, <<"[[object]]"/utf8>>}.
{'clojure.pprint', <<"with-pprint-dispatch"/utf8>>, <<"Execute body with the pretty print dispatch function bound to function."/utf8>>, <<"([function & body])"/utf8>>}.
{'clojure.pprint', <<"write"/utf8>>, <<"Write an object subject to the current bindings of the printer control variables.\nUse the kw-args argument to override individual variables for this call (and any \nrecursive calls). Returns the string result if :stream is nil or nil otherwise.\n\nThe following keyword arguments can be passed with values:\n  Keyword              Meaning                              Default value\n  :stream              Writer for output or nil             true (indicates *out*)\n  :base                Base to use for writing rationals    Current value of *print-base*\n  :circle*             If true, mark circular structures    Current value of *print-circle*\n  :length              Maximum elements to show in sublists Current value of *print-length*\n  :level               Maximum depth                        Current value of *print-level*\n  :lines*              Maximum lines of output              Current value of *print-lines*\n  :miser-width         Width to enter miser mode            Current value of *print-miser-width*\n  :dispatch            The pretty print dispatch function   Current value of *print-pprint-dispatch*\n  :pretty              If true, do pretty printing          Current value of *print-pretty*\n  :radix               If true, prepend a radix specifier   Current value of *print-radix*\n  :readably*           If true, print readably              Current value of *print-readably*\n  :right-margin        The column for the right margin      Current value of *print-right-margin*\n  :suppress-namespaces If true, no namespaces in symbols    Current value of *print-suppress-namespaces*\n\n  * = not yet supported\n"/utf8>>, <<"([object & kw-args])"/utf8>>}.
{'clojure.pprint', <<"write-out"/utf8>>, <<"Write an object to *out* subject to the current bindings of the printer control \nvariables. Use the kw-args argument to override individual variables for this call (and \nany recursive calls).\n\n*out* must be a PrettyWriter if pretty printing is enabled. This is the responsibility\nof the caller.\n\nThis method is primarily intended for use by pretty print dispatch functions that \nalready know that the pretty printer will have set up their environment appropriately.\nNormal library clients should use the standard \"write\" interface. "/utf8>>, <<"([object])"/utf8>>}.
{'clojure.zip', <<"append-child"/utf8>>, <<"Inserts the item as the rightmost child of the node at this loc,\n  without moving"/utf8>>, <<"([loc item])"/utf8>>}.
{'clojure.zip', <<"branch?"/utf8>>, <<"Returns true if the node at loc is a branch"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"children"/utf8>>, <<"Returns a seq of the children of node at loc, which must be a branch"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"down"/utf8>>, <<"Returns the loc of the leftmost child of the node at this loc, or\n  nil if no children"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"edit"/utf8>>, <<"Replaces the node at this loc with the value of (f node args)"/utf8>>, <<"([loc f & args])"/utf8>>}.
{'clojure.zip', <<"end?"/utf8>>, <<"Returns true if loc represents the end of a depth-first walk"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"insert-child"/utf8>>, <<"Inserts the item as the leftmost child of the node at this loc,\n  without moving"/utf8>>, <<"([loc item])"/utf8>>}.
{'clojure.zip', <<"insert-left"/utf8>>, <<"Inserts the item as the left sibling of the node at this loc,\n without moving"/utf8>>, <<"([loc item])"/utf8>>}.
{'clojure.zip', <<"insert-right"/utf8>>, <<"Inserts the item as the right sibling of the node at this loc,\n  without moving"/utf8>>, <<"([loc item])"/utf8>>}.
{'clojure.zip', <<"left"/utf8>>, <<"Returns the loc of the left sibling of the node at this loc, or nil"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"leftmost"/utf8>>, <<"Returns the loc of the leftmost sibling of the node at this loc, or self"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"lefts"/utf8>>, <<"Returns a seq of the left siblings of this loc"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"make-node"/utf8>>, <<"Returns a new branch node, given an existing node and new\n  children. The loc is only used to supply the constructor."/utf8>>, <<"([loc node children])"/utf8>>}.
{'clojure.zip', <<"next"/utf8>>, <<"Moves to the next loc in the hierarchy, depth-first. When reaching\n  the end, returns a distinguished loc detectable via end?. If already\n  at the end, stays there."/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"node"/utf8>>, <<"Returns the node at loc"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"path"/utf8>>, <<"Returns a seq of nodes leading to this loc"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"prev"/utf8>>, <<"Moves to the previous loc in the hierarchy, depth-first. If already\n  at the root, returns nil."/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"remove"/utf8>>, <<"Removes the node at loc, returning the loc that would have preceded\n  it in a depth-first walk."/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"replace"/utf8>>, <<"Replaces the node at this loc, without moving"/utf8>>, <<"([loc node])"/utf8>>}.
{'clojure.zip', <<"right"/utf8>>, <<"Returns the loc of the right sibling of the node at this loc, or nil"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"rightmost"/utf8>>, <<"Returns the loc of the rightmost sibling of the node at this loc, or self"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"rights"/utf8>>, <<"Returns a seq of the right siblings of this loc"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"root"/utf8>>, <<"zips all the way up and returns the root node, reflecting any\n changes."/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"seq-zip"/utf8>>, <<"Returns a zipper for nested sequences, given a root sequence"/utf8>>, <<"([root])"/utf8>>}.
{'clojure.zip', <<"up"/utf8>>, <<"Returns the loc of the parent of the node at this loc, or nil if at\n  the top"/utf8>>, <<"([loc])"/utf8>>}.
{'clojure.zip', <<"vector-zip"/utf8>>, <<"Returns a zipper for nested vectors, given a root vector"/utf8>>, <<"([root])"/utf8>>}.
{'clojure.zip', <<"xml-zip"/utf8>>, <<"Returns a zipper for xml elements (as from xml/parse),\n  given a root element"/utf8>>, <<"([root])"/utf8>>}.
{'clojure.zip', <<"zipper"/utf8>>, <<"Creates a new zipper structure. \n\n  branch? is a fn that, given a node, returns true if can have\n  children, even if it currently doesn't.\n\n  children is a fn that, given a branch node, returns a seq of its\n  children.\n\n  make-node is a fn that, given an existing node and a seq of\n  children, returns a new branch node with the supplied children.\n  root is the root node."/utf8>>, <<"([branch? children make-node root])"/utf8>>}.
{'clojure.data', <<"Diff"/utf8>>, <<"Implementation detail. Subject to change."/utf8>>, nil}.
{'clojure.data', <<"EqualityPartition"/utf8>>, <<"Implementation detail. Subject to change."/utf8>>, nil}.
{'clojure.data', <<"diff"/utf8>>, <<"Recursively compares a and b, returning a tuple of\n  [things-only-in-a things-only-in-b things-in-both].\n  Comparison rules:\n\n  * For equal a and b, return [nil nil a].\n  * Maps are subdiffed where keys match and values differ.\n  * Sets are never subdiffed.\n  * All sequential things are treated as associative collections\n    by their indexes, with results returned as vectors.\n  * Everything else (including strings!) is treated as\n    an atom and compared for equality."/utf8>>, <<"([a b])"/utf8>>}.
{'clojure.data', <<"diff-similar"/utf8>>, <<"Implementation detail. Subject to change."/utf8>>, <<"([a b])"/utf8>>}.
{'clojure.data', <<"equality-partition"/utf8>>, <<"Implementation detail. Subject to change."/utf8>>, <<"([x])"/utf8>>}.
