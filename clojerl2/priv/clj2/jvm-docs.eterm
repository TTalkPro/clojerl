{'clojure.core', <<"val"/utf8>>, <<"Returns the value in the map entry."/utf8>>, <<"([e])"/utf8>>}.
{'clojure.core', <<"vals"/utf8>>, <<"Returns a sequence of the map's values, in the same order as (seq map)."/utf8>>, <<"([map])"/utf8>>}.
{'clojure.core', <<"var-get"/utf8>>, <<"Gets the value in the var object"/utf8>>, <<"([x])"/utf8>>}.
