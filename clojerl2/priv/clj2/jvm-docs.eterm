{'clojure.core', <<"commute"/utf8>>, <<"Must be called in a transaction. Sets the in-transaction-value of\n  ref to:\n\n  (apply fun in-transaction-value-of-ref args)\n\n  and returns the in-transaction-value of ref.\n\n  At the commit point of the transaction, sets the value of ref to be:\n\n  (apply fun most-recently-committed-value-of-ref args)\n\n  Thus fun should be commutative, or, failing that, you must accept\n  last-one-in-wins behavior.  commute allows for more concurrency than\n  ref-set."/utf8>>, <<"([ref fun & args])"/utf8>>}.
{'clojure.core', <<"comp"/utf8>>, <<"Takes a set of functions and returns a fn that is the composition\n  of those fns.  The returned fn takes a variable number of args,\n  applies the rightmost of fns to the args, the next\n  fn (right-to-left) to the result, etc."/utf8>>, <<"([] [f] [f g] [f g & fs])"/utf8>>}.
{'clojure.core', <<"comparator"/utf8>>, <<"Returns an implementation of java.util.Comparator based upon pred."/utf8>>, <<"([pred])"/utf8>>}.
{'clojure.core', <<"compare"/utf8>>, <<"Comparator. Returns a negative number, zero, or a positive number\n  when x is logically 'less than', 'equal to', or 'greater than'\n  y. Same as Java x.compareTo(y) except it also works for nil, and\n  compares numbers and collections in a type-independent manner. x\n  must implement Comparable"/utf8>>, <<"([x y])"/utf8>>}.
{'clojure.core', <<"compare-and-set!"/utf8>>, <<"Atomically sets the value of atom to newval if and only if the\n  current value of the atom is identical to oldval. Returns true if\n  set happened, else false"/utf8>>, <<"([atom oldval newval])"/utf8>>}.
{'clojure.core', <<"compile"/utf8>>, <<"Compiles the namespace named by the symbol lib into a set of\n  classfiles. The source for the lib must be in a proper\n  classpath-relative directory. The output files will go into the\n  directory specified by *compile-path*, and that directory too must\n  be in the classpath."/utf8>>, <<"([lib])"/utf8>>}.
{'clojure.core', <<"complement"/utf8>>, <<"Takes a fn f and returns a fn that takes the same arguments as f,\n  has the same effects, if any, and returns the opposite truth value."/utf8>>, <<"([f])"/utf8>>}.
{'clojure.core', <<"completing"/utf8>>, <<"Takes a reducing function f of 2 args and returns a fn suitable for\n  transduce by adding an arity-1 signature that calls cf (default -\n  identity) on the result argument."/utf8>>, <<"([f] [f cf])"/utf8>>}.
{'clojure.core', <<"concat"/utf8>>, <<"Returns a lazy seq representing the concatenation of the elements in the supplied colls."/utf8>>, <<"([] [x] [x y] [x y & zs])"/utf8>>}.
{'clojure.core', <<"cond"/utf8>>, <<"Takes a set of test/expr pairs. It evaluates each test one at a\n  time.  If a test returns logical true, cond evaluates and returns\n  the value of the corresponding expr and doesn't evaluate any of the\n  other tests or exprs. (cond) returns nil."/utf8>>, <<"([& clauses])"/utf8>>}.
{'clojure.core', <<"cond->"/utf8>>, <<"Takes an expression and a set of test/form pairs. Threads expr (via ->)\n  through each form for which the corresponding test\n  expression is true. Note that, unlike cond branching, cond-> threading does\n  not short circuit after the first true test expression."/utf8>>, <<"([expr & clauses])"/utf8>>}.
{'clojure.core', <<"cond->>"/utf8>>, <<"Takes an expression and a set of test/form pairs. Threads expr (via ->>)\n  through each form for which the corresponding test expression\n  is true.  Note that, unlike cond branching, cond->> threading does not short circuit\n  after the first true test expression."/utf8>>, <<"([expr & clauses])"/utf8>>}.
{'clojure.core', <<"condp"/utf8>>, <<"Takes a binary predicate, an expression, and a set of clauses.\n  Each clause can take the form of either:\n\n  test-expr result-expr\n\n  test-expr :>> result-fn\n\n  Note :>> is an ordinary keyword.\n\n  For each clause, (pred test-expr expr) is evaluated. If it returns\n  logical true, the clause is a match. If a binary clause matches, the\n  result-expr is returned, if a ternary clause matches, its result-fn,\n  which must be a unary function, is called with the result of the\n  predicate as its argument, the result of that call being the return\n  value of condp. A single default expression can follow the clauses,\n  and its value will be returned if no clause matches. If no default\n  expression is provided and no clause matches, an\n  IllegalArgumentException is thrown."/utf8>>, <<"([pred expr & clauses])"/utf8>>}.
{'clojure.core', <<"conj"/utf8>>, <<"conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).\n    (conj coll) returns coll. (conj) returns [].\n    The 'addition' may happen at different 'places' depending\n    on the concrete type."/utf8>>, <<"([] [coll] [coll x] [coll x & xs])"/utf8>>}.
{'clojure.core', <<"conj!"/utf8>>, <<"Adds x to the transient collection, and return coll. The 'addition'\n  may happen at different 'places' depending on the concrete type."/utf8>>, <<"([] [coll] [coll x])"/utf8>>}.
{'clojure.core', <<"cons"/utf8>>, <<"Returns a new seq where x is the first element and seq is\n    the rest."/utf8>>, <<"([x seq])"/utf8>>}.
{'clojure.core', <<"constantly"/utf8>>, <<"Returns a function that takes any number of arguments and returns x."/utf8>>, <<"([x])"/utf8>>}.
{'clojure.core', <<"construct-proxy"/utf8>>, <<"Takes a proxy class and any arguments for its superclass ctor and\n  creates and returns an instance of the proxy."/utf8>>, <<"([c & ctor-args])"/utf8>>}.
{'clojure.core', <<"contains?"/utf8>>, <<"Returns true if key is present in the given collection, otherwise\n  returns false.  Note that for numerically indexed collections like\n  vectors and Java arrays, this tests if the numeric key is within the\n  range of indexes. 'contains?' operates constant or logarithmic time;\n  it will not perform a linear search for a value.  See also 'some'."/utf8>>, <<"([coll key])"/utf8>>}.
{'clojure.core', <<"count"/utf8>>, <<"Returns the number of items in the collection. (count nil) returns\n  0.  Also works on strings, arrays, and Java Collections and Maps"/utf8>>, <<"([coll])"/utf8>>}.
{'clojure.core', <<"counted?"/utf8>>, <<"Returns true if coll implements count in constant time"/utf8>>, <<"([coll])"/utf8>>}.
{'clojure.core', <<"create-ns"/utf8>>, <<"Create a new namespace named by the symbol if one doesn't already\n  exist, returns it or the already-existing namespace of the same\n  name."/utf8>>, <<"([sym])"/utf8>>}.
{'clojure.core', <<"create-struct"/utf8>>, <<"Returns a structure basis object."/utf8>>, <<"([& keys])"/utf8>>}.
{'clojure.core', <<"cycle"/utf8>>, <<"Returns a lazy (infinite!) sequence of repetitions of the items in coll."/utf8>>, <<"([coll])"/utf8>>}.
{'clojure.core', <<"dec"/utf8>>, <<"Returns a number one less than num. Does not auto-promote\n  longs, will throw on overflow. See also: dec'"/utf8>>, <<"([x])"/utf8>>}.
