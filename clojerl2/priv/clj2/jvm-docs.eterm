{'clojure.core', <<"take"/utf8>>, <<"Returns a lazy sequence of the first n items in coll, or all items if\n  there are fewer than n.  Returns a stateful transducer when\n  no collection is provided."/utf8>>, <<"([n] [n coll])"/utf8>>}.
{'clojure.core', <<"take-last"/utf8>>, <<"Returns a seq of the last n items in coll.  Depending on the type\n  of coll may be no better than linear time.  For vectors, see also subvec."/utf8>>, <<"([n coll])"/utf8>>}.
{'clojure.core', <<"take-nth"/utf8>>, <<"Returns a lazy seq of every nth item in coll.  Returns a stateful\n  transducer when no collection is provided."/utf8>>, <<"([n] [n coll])"/utf8>>}.
{'clojure.core', <<"take-while"/utf8>>, <<"Returns a lazy sequence of successive items from coll while\n  (pred item) returns logical true. pred must be free of side-effects.\n  Returns a transducer when no collection is provided."/utf8>>, <<"([pred] [pred coll])"/utf8>>}.
{'clojure.core', <<"tap>"/utf8>>, <<"sends x to any taps. Will not block. Returns true if there was room in the queue,\n  false if not (dropped)."/utf8>>, <<"([x])"/utf8>>}.
