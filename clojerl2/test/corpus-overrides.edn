;; clojerl2 overrides of corpus rows (clojerl2-020).
;;
;; test/corpus.edn stays as JVM Clojure gives it (make corpus-regen). A row
;; whose test or expected value cannot hold here because of a registered
;; divergence is overridden here instead, citing that divergence (:because,
;; an id in known-divergences.edn):
;;   :actual    the test rewritten to test the same thing the clojerl2 way
;;              (where possible, still valid on the JVM with the same result)
;;   :expected  the value clojerl2 gives, when the row tests the divergent
;;              behaviour itself
;;   :skip      true: the divergence leaves the row's result undefined here
;;              (it is not run)
;; clj2_corpus applies them when it reads the corpus; clj2_divergences_tests
;; checks every :because is registered and every row exists.
[
 {:suite "io / print family (overlay)" :label "pr writes no newline" :because :char/integer :expected "\"97\"" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "io / print family (overlay)" :label "str of a char is bare" :because :char/integer :expected "\"97\"" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "predicates / numeric guards & every? (overlay moves)" :label "char? number" :because :char/integer :expected "true" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "regex / \\p property classes" :label "p{IsHex_Digit} takes every Nd digit, as the JVM does" :because :char/integer :actual "(mapv #(boolean (re-matches #\"\\p{IsHex_Digit}\" (unicode/characters_to_binary (list %)))) [0x0660 0x0966 0x1C50 0xFF10 0x0041 0x0047])" :note "a code point to a one-char string, the clojerl2 way"}
 {:suite "regex / \\Q quoting" :label "the quote is rewritten away before the pattern is read, so \\c sees the quoted letter" :because :char/integer :actual "(boolean (re-matches #\"\\c\\QZ\" \"\\u001A\"))" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / inline flag groups" :label "COMMENTS skips after \\c too, so the control letter is the next unit that survives" :because :char/integer :actual "[(boolean (re-matches #\"(?x)\\c A\" \"\\u0001\")) (boolean (re-matches #\"\\cA\" \"\\u0001\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / escapes in and out of a character class" :label "\\a is BEL in both contexts" :because :char/integer :actual "[(boolean (re-find #\"[\\a]\" \"\\u0007\")) (boolean (re-find #\"[\\a]\" \"a\")) (boolean (re-find #\"\\a\" \"\\u0007\")) (boolean (re-find #\"\\a\" \"a\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / escapes in and out of a character class" :label "\\e is ESC in both contexts" :because :char/integer :actual "[(boolean (re-find #\"[\\e]\" \"\\u001B\")) (boolean (re-find #\"[\\e]\" \"e\")) (boolean (re-find #\"\\e\" \"\\u001B\")) (boolean (re-find #\"\\e\" \"e\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / escapes in and out of a character class" :label "\\cX is the control character in both contexts" :because :char/integer :actual "[(boolean (re-find #\"[\\cA]\" \"\\u0001\")) (boolean (re-find #\"[\\cA]\" \"c\")) (boolean (re-find #\"\\cA\" \"\\u0001\")) (boolean (re-find #\"\\cA\" \"c\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / escapes in and out of a character class" :label "\\c@ \\cZ \\ca are xor-64 of the raw char" :because :char/integer :actual "[(boolean (re-find #\"\\c@\" \"\\u0000\")) (boolean (re-find #\"\\cZ\" \"\\u001A\")) (boolean (re-find #\"\\ca\" \"\\u0021\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / escapes in and out of a character class" :label "\\t \\n \\r \\f inside a class" :because :char/integer :actual "[(boolean (re-find #\"[\\t\\n\\r\\f]\" \"\\u0009\")) (boolean (re-find #\"[\\t\\n\\r\\f]\" \"\\u000C\")) (boolean (re-find #\"[\\t\\n\\r\\f]\" \"t\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "regex / escapes in and out of a character class" :label "a class unions its escaped members" :because :char/integer :actual "(mapv (fn [s] (boolean (re-find #\"[\\a\\e\\f]\" s))) [\"\\u0007\" \"\\u001B\" \"\\u000C\" \"a\"])" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "clojure.string / unicode whitespace" :label "trim and blank? follow isWhitespace" :because :char/integer :actual "(do (require (quote [clojure.string :as s])) (let [ideo \"\\u3000\" nb \"\\u00A0\"] [(s/trim (str ideo \"a\" ideo)) (= (str nb \"a\" nb) (s/trim (str nb \"a\" nb))) (s/blank? ideo) (s/blank? nb)]))" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "clojure.string / unicode whitespace" :label "triml and trimr reach the separators" :because :char/integer :actual "(do (require (quote [clojure.string :as s])) [(s/triml (str \"\\u2028\" \"a\")) (s/trimr (str \"a\" \"\\u1680\"))])" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "clojure.string / unicode whitespace" :label "\\p{Z} covers the separator categories" :because :char/integer :actual "(let [re (re-pattern \"(?u)^[\\\\s\\\\p{Z}]+$\")] (mapv (fn [c] (boolean (re-matches re (str c)))) [\"\\u0020\" \"\\u00A0\" \"\\u3000\" \"\\u2028\" \"\\u1680\" \"\\u2007\" \"\\t\" \"\\n\" \"a\"]))" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "clojure.string / unicode whitespace" :label "Zs, Zl and Zp are distinct" :because :char/integer :actual "[(boolean (re-matches (re-pattern \"^\\\\p{Zs}+$\") \"\\u2000\")) (boolean (re-matches (re-pattern \"^\\\\p{Zl}$\") \"\\u2028\")) (boolean (re-matches (re-pattern \"^\\\\p{Zp}$\") \"\\u2029\")) (boolean (re-matches (re-pattern \"^\\\\p{Z}$\") \"a\"))]" :note "the same test with each (str (char N)) written as the string literal \"\\uNNNN\"; checked to give the JVM result on the JVM"}
 {:suite "conformance / characters" :label "str of chars" :because :char/integer :expected "\"979899\"" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "conformance / characters" :label "pr-str char" :because :char/integer :expected "\"97\"" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "conformance / characters" :label "apply str chars" :because :char/integer :expected "\"104105\"" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "equality / base scalars of different kinds" :label "char vs its code point" :because :char/integer :expected "true" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "strings / str small arities" :label "char and string" :because :char/integer :expected "\"97b\"" :note "chars are code points: this is the value clojerl2 gives"}
 {:suite "map / the stored key, not the probe key" :label "so does assoc in the trie" :because :collections/exact-keys :skip true :note "the two keys differ in metadata, so both are kept and which one comes first depends on Erlang's map order: no defined result to check"}]

