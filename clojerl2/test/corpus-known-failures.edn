
;; clojerl2 corpus known failures (designs/04 §5.1 gate, clojerl2-022).
;;
;; Every :common corpus entry that fails is listed here with its cause:
;; a divergence id from known-divergences.edn (a deliberate difference)
;; or a :pending cause below (work not done yet). `make certify' fails on
;; a failure that is not listed and on a listed entry that passes.
;;
;; Generated by `make corpus-rebaseline' (clj2_corpus:rebaseline/0), which
;; keeps the cause of entries already listed: to triage an entry, edit its
;; :cause here (e.g. to a divergence id) and it sticks.
{:pending
 {:pending/multimethods {:reason "defmulti/defmethod and hierarchies are not implemented yet." :task "clojerl2-017"}
  :pending/ref-types {:reason "Var-root operations are not implemented yet: alter-var-root, with-redefs, with-local-vars, var-get/var-set; also locking. (atoms, agents, futures, promises, volatiles and binding came with clojerl2-018.)" :task "clojerl2-018 follow-up"}
  :pending/strings-io {:reason "regexes, format, string/char functions and reader/writer IO are not implemented yet." :task "clojerl2-020"}
  :pending/runtime-eval {:reason "Namespace reflection is not implemented yet: ns-publics/ns-map/ns-aliases/ns-unmap/intern/resolve, var objects (var-get, var?), alias/refer as functions, an ns form inside a namespace file. (eval, read-string, require, in-ns came with clojerl2-023.)" :task "clojerl2-023 follow-up"}
  :pending/metadata {:reason "meta/with-meta/vary-meta on values are not implemented yet." :task "clojerl2-021 follow-up"}
  :pending/sorted-colls {:reason "sorted maps and sets are not implemented yet." :task "clojerl2-021 follow-up"}
  :pending/transients {:reason "transient/persistent! and the bang ops are not implemented yet." :task "clojerl2-021 follow-up"}
  :pending/host-types {:reason "class/type/instance? and other host type queries are not implemented yet; JVM class names need a mapping onto clj2 type tags." :task "clojerl2-021 follow-up"}
  :pending/stdlib-namespaces {:reason "clojure.string, clojure.set, clojure.walk, clojure.edn, clojure.math ... are not ported yet." :task "clojerl2-021 follow-up"}
  :pending/missing-core-var {:reason "A clojure.core var, or an arity of one (transducer arities, variadic bit ops ...), is not ported yet." :task "clojerl2-021 follow-up"}
  :pending/special-forms {:reason "A special form (var, set!, ., new, letfn* ...) is not compiled yet." :task "clojerl2-021 follow-up"}
  :pending/numbers {:reason "BigDecimal (1.5M) literals and arithmetic are not implemented yet." :task "clojerl2-021 follow-up"}
  :pending/reader {:reason "The reader rejects the source (reader conditionals, number syntax, escapes ...)." :task "clojerl2-021 follow-up"}
  :pending/compiler {:reason "The compiler rejects the entry (syntax, linking, recur, verify ...): a compiler gap or bug." :task "clojerl2-021 follow-up"}
  :pending/triage {:reason "Runs but disagrees with the JVM (wrong value, unexpected or missing throw, timeout, crash). Each must be fixed or moved to a registered divergence." :task "clojerl2-022 follow-up"}}
