
;; clojerl2 corpus known failures (designs/04 §5.1 gate, clojerl2-022).
;;
;; Every :common corpus entry that fails is listed here with its cause:
;; a divergence id from known-divergences.edn (a deliberate difference)
;; or a :pending cause below (work not done yet). `make certify' fails on
;; a failure that is not listed and on a listed entry that passes.
;;
;; Generated by `make corpus-rebaseline' (clj2_corpus:rebaseline/0), which
;; keeps the cause of entries already listed: to triage an entry, edit its
;; :cause here (e.g. to a divergence id) and it sticks.
{:pending
 {:pending/multimethods {:reason "defmulti/defmethod and hierarchies are not implemented yet." :task "clojerl2-017"}
  :pending/ref-types {:reason "Atom construction options (:meta, a :validator that rejects the initial value) and alter-meta! on atoms; atom validator failures are not IllegalStateException. (Var-root operations came with clojerl2-032.)" :task "clojerl2-033 triage"}
  :pending/var-surface {:reason "Var objects: the Java surface of clojure.lang.Var (isBound, hasRoot, bindRoot, alterRoot, setMacro, ns/sym, getRawRoot, unbindRoot, set, Var/intern, fn), thread-bound?/get-thread-bindings; core vars carry no :doc. (Using a namespace's vars through var objects while it loads came with clojerl2-034.)" :task "clojerl2-033 triage"}
  :pending/jvm-exceptions {:reason "An error is raised, but not as the JVM's exception class or message. (Erlang errors refined by the failing call, clj2 error terms, casts, String methods and parse messages came with clojerl2-035.)" :task "clojerl2-035"}
  :pending/arg-checks {:reason "A core fn accepts an argument the JVM rejects, or rejects one the JVM accepts. (find, nth, peek, pop, rseq, shuffle, nthrest, numeric predicates, symbol/keyword, odd kvs, counts, contains? on strings, keyword ordering ... came with clojerl2-035.)" :task "clojerl2-035"}
  :pending/laziness {:reason "Realization timing differs: iterate calls f early, mapcat/dedupe realize late, pmap is not semi-lazy, sequence realizes its first element only when walked, an eduction is a seq, ~@ realizes a spliced seq while building the template." :task "clojerl2-033 triage"}
  :pending/printer {:reason "Printing: the print-method multimethod (user methods for records and host classes), *print-length*/*print-level* on records and sorted collections and nested levels, *print-meta*, *print-namespace-maps*, str of a Class (class X), subnormal doubles, str of an ex-info, a caught host fault printed as #error." :task "clojerl2-033 triage"}
  :pending/records {:reason "Records: map?/coll? of a record, conj of an entry or a map onto a record, deftype vs defrecord map?, __extmap/__meta fields." :task "clojerl2-033 triage"}
  :pending/regex-edge {:reason "Edge cases of the Java regex translation (clj2_re): control escapes (backslash-c) with (?x), backslash-Q inside them, look-behind bound checks, empty intersections, quantified empty flag groups." :task "clojerl2-033 triage"}
  :pending/format-edge {:reason "Edge cases of format (java.util.Formatter): # with zero padding, + on unsigned conversions, argument index 0, width on %n, %a rounding and subnormals." :task "clojerl2-033 triage"}
  :pending/core-bugs {:reason "Wrong results of core macros and fns: for's :while after :let/:when, definline, cond-> expansion shape, destructuring a map with a rest pattern, the multi-input map transducer, case with mixed constants, with-open on a non-closeable, a protocol miss on nil when Object is extended, transient nil keys, attr-map :doc over the docstring, *suppress-read*." :task "clojerl2-033 triage"}
  :pending/corpus-environment {:reason "The expected value depends on where the corpus was generated (a README the JVM run read, a deref the regeneration timed out on, *ns*: the JVM evaluated each entry at a REPL in user, the harness loads it as a namespace of its own and loading binds *ns* to it); needs a corpus override, not a fix." :task "clojerl2-033 triage"}
  :pending/strings-io {:reason "regexes, format, string/char functions and reader/writer IO are not implemented yet." :task "clojerl2-020"}
  :pending/runtime-eval {:reason "Namespace reflection is not implemented yet: ns-publics/ns-map/ns-aliases/ns-unmap/intern/resolve, var objects (var-get, var?), alias/refer as functions, an ns form inside a namespace file. (eval, read-string, require, in-ns came with clojerl2-023.)" :task "clojerl2-023 follow-up"}
  :pending/metadata {:reason "meta/with-meta/vary-meta on values are not implemented yet; conj/pop/into on a list and select-keys drop metadata." :task "clojerl2-021 follow-up"}
  :pending/sorted-colls {:reason "sorted maps and sets are not implemented yet." :task "clojerl2-021 follow-up"}
  :pending/transients {:reason "transient/persistent! and the bang ops are not implemented yet." :task "clojerl2-021 follow-up"}
  :pending/host-types {:reason "class/type/instance? and other host type queries are not implemented yet; JVM class names need a mapping onto clj2 type tags; host classes and members not shimmed yet (Thread, Math statics, Keyword methods ...)." :task "clojerl2-021 follow-up"}
  :pending/stdlib-namespaces {:reason "A standard library namespace or var not ported yet (clojure.data, clojure.zip, clojure.datafy ...). (clojure.edn, clojure.math, clojure.pprint and clojure.repl came with clojerl2-039.)" :task "clojerl2-039"}
  :pending/missing-core-var {:reason "A clojure.core var, or an arity of one, is not ported yet. (sorted-map?/sorted-set?, thread-bound?, get-thread-bindings, tagged-literal and reader-conditional, Inst/inst-ms, xml-seq, struct maps, the proxy stubs, conj! and read-string arities, test, bytes ... came with clojerl2-036.)" :task "clojerl2-036"}
  :pending/special-forms {:reason "A special form (var, set!, ., new, letfn* ...) is not compiled yet." :task "clojerl2-021 follow-up"}
  :pending/numbers {:reason "A numeric gap that is not a registered divergence. (BigDecimal literals, arithmetic, with-precision, printing and the java.math.BigDecimal surface came with clojerl2-037.)" :task "clojerl2-037"}
  :pending/reader {:reason "The reader rejects the source (reader conditionals, number syntax, escapes ...), or reports a read error unlike the JVM." :task "clojerl2-021 follow-up"}
  :pending/compiler {:reason "The compiler rejects the entry: defrecord, extend-protocol and the like inside an expression (they are top-level forms here). (loop* inits in order, nested syntax-quote and its JVM construction code, destructured deftype/defmacro params, Object methods, deftype options, defprotocol options, trailing attr-maps, declare, defonce, lazy apply came with clojerl2-038.)" :task "clojerl2-038"}
  :pending/triage {:reason "Runs but disagrees with the JVM (wrong value, unexpected or missing throw, timeout, crash), cause not yet known: a new failure lands here until it is triaged into a concrete cause or a registered divergence." :task "clojerl2-033"}}
