%% A clojerl2 project built with rebar3 (clojerl2-024's acceptance example).
%% Here clojerl2 and the plugin come from _checkouts (symlinks into this
%% repository); a real project would name them as git/hex dependencies.
{deps, [clojerl2]}.
{plugins, [rebar3_clojerl2]}.

%% where the namespaces are (default ["src"])
{clj2_src_dirs, ["src"]}.
